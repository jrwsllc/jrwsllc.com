# Clean URLs: serve apps.php/books.php/games.php at /apps, /books, /games
# without exposing the .php extension. Plain Apache mod_rewrite — no
# framework, no build step, works as-is on Plesk/Apache shared hosting.

RewriteEngine On

# /apps -> apps.php (and same for books, games) if the .php file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.php [L]

# Redirect direct .php requests to the clean URL (canonical, avoids
# duplicate-content URLs). Limited to GET page requests and excludes
# contact.php, which is a POST-only form handler that must not be
# redirected (a 301 would drop the POST body).
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s/+(apps|books|games)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
